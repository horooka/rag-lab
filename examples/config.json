{
  "db_path": ".rag/index.db",
  "mode": "hybrid",
  "top_k": 10,
  "batch_size": 8,
  "threads": 8,
  "include_docs": true,
  "exclude": [
    "build/*",
    "*/build/*",
    "third_party/*",
    "vendor/*",
    "node_modules/*"
  ],
  "chunk": {
    "max_tokens": 512,
    "window_lines": 60,
    "overlap_lines": 12,
    "include_header": true
  },
  "chunkers": [
    {"match": "*.md", "type": "markdown", "max_tokens": 300},
    {"match": "*.markdown", "type": "markdown", "max_tokens": 300},
    {"match": "*.c", "type": "treesitter", "max_tokens": 512},
    {"match": "*.h", "type": "treesitter", "max_tokens": 512},
    {"match": "*.cc", "type": "treesitter", "max_tokens": 512},
    {"match": "*.cpp", "type": "treesitter", "max_tokens": 512},
    {"match": "*.hpp", "type": "treesitter", "max_tokens": 512},
    {"match": "*.py", "type": "treesitter", "max_tokens": 512},
    {"match": "CMakeLists.txt", "type": "window", "window_lines": 80, "overlap_lines": 8},
    {"match": "*", "type": "window", "window_lines": 60, "overlap_lines": 12}
  ]
}
